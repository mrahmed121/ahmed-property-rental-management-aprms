# APRMS — Ahmed Property & Rental Management System
# Never commit secrets, local state, or build artifacts.

# --- Secrets & local env ---
.env
.env.backup
.env.production
*.key
*.pem

# --- Laravel backend ---
/backend/vendor/
/backend/node_modules/
backend/public/hot
backend/public/storage
backend/storage/*.key
backend/storage/app/private
backend/storage/app/public
backend/storage/framework/cache/data/*
backend/storage/framework/sessions/*
backend/storage/framework/views/*
backend/storage/logs/*.log
backend/bootstrap/cache/*.php
!backend/bootstrap/cache/.gitignore

# --- Frontend ---
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/*.local

# --- OS / editors ---
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*.swo

# --- Misc ---
*.log
npm-debug.log*
.cache/

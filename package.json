{"description":"Ahmed Property & Rental Management System — development convenience scripts","devDependencies":{"concurrently":"^9.0.0"},"name":"aprms","private":true,"scripts":{"build:frontend":"cd frontend && npm run build","dev":"concurrently \"npm run dev:backend\" \"npm run dev:frontend\"","dev:backend":"cd backend && php artisan serve --host=127.0.0.1 --port=8000","dev:frontend":"cd frontend && npm run dev -- --host 127.0.0.1 --port 5173","install:all":"cd backend && composer install && cd ../frontend && npm install","test:backend":"cd backend && php artisan test","test:frontend":"cd frontend && npm test -- --run"},"version":"1.0.0"}
# =====================================================================
# APRMS — Ahmed Property & Rental Management System
# Copy to backend/.env and fill in real values. NEVER commit .env.
# =====================================================================

APP_NAME="APRMS"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://127.0.0.1:8000

# --- Database (SQLite zero-config default; MySQL/PostgreSQL compatible) ---
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=aprms
# DB_USERNAME=root
# DB_PASSWORD=

# --- JWT (generate with: php artisan jwt:secret) ---
JWT_SECRET=
JWT_TTL=120
JWT_REFRESH_TTL=20160

# --- Frontend ---
FRONTEND_URL=http://localhost:5173

# --- Session / cache (keep simple for P1) ---
SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync

LOG_CHANNEL=stack
LOG_LEVEL=info
